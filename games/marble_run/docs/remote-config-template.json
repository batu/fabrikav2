        },
        "interstitial_fail_cooldown_s": {
          "defaultValue": {
            "value": "90"
          },
          "description": "Minimum seconds since the last interstitial before a fail may show one.",
          "valueType": "NUMBER"
        },
        "interstitial_level_end_cooldown_s": {
          "defaultValue": {
            "value": "90"
          },
          "description": "Minimum seconds since the last interstitial before a completed level may show one.",
          "valueType": "NUMBER"
        },
        "rewarded_ads_enabled": {
          "defaultValue": {
            "value": "true"
          },
          "description": "Master switch for every rewarded placement (hints, claim x2, fail continue).",
          "valueType": "BOOLEAN"
        }
