        "reward_progress_goal": {
          "defaultValue": {
            "value": "6"
          },
          "description": "Level completions required for the home reward.",
          "valueType": "NUMBER"
        },
        "reward_hints_amount": {
          "defaultValue": {
            "value": "4"
          },
          "description": "Hints granted when reward progress completes.",
          "valueType": "NUMBER"
        },
        "gameplay_initial_hints": {
          "defaultValue": {
            "value": "3"
          },
          "description": "Default starting hints for new players.",
          "valueType": "NUMBER"
        },
        "rate_prompt_enabled_default": {
          "defaultValue": {
            "value": "true"
