# Marble Run production SDK configuration (TRACKED — see note below).
# Every value here is a client-side identifier that ships inside the public app
# bundle (and most already live in the tracked sdk_integration spreadsheet), so
# tracking them adds no exposure. Genuine server secrets must NEVER go here —
# they belong in the untracked .env. Vite precedence: this file WINS over .env
# for `npm run build` (production mode); dev servers never load it.
# This file exists so TestFlight/release builds are reproducible from main.

VITE_APPLOVIN_IOS_ENABLED=true
VITE_APPLOVIN_IOS_GENERAL_AUDIENCE_ONLY=true
VITE_APPLOVIN_IOS_SDK_KEY=Z3rGm2U66OxDUU789s3cOd_ZEQ4X5DTfS61WPmPZP1hOPeGsrkvROU3y9P_c4iMHCNtekGcC0wS9bLWsyGwBUP
# Publisher-supplied MAX unit ids (2026-08-03 batch): newly created standard units.
# Old ids (REWARDED_INTER format, rejected by SDK 13.5.1 on device 2026-07-27):
#   rewarded d516d39f20c54af0, interstitial e959cabdfd0981de
# Supersedes the single unknown-format id that logged REWARDED_INTER.
VITE_APPLOVIN_IOS_REWARDED_ID=a530ac16c61b0899
VITE_APPLOVIN_IOS_INTERSTITIAL_ID=ac793825199f97bd
VITE_APPLOVIN_ANDROID_ENABLED=true
VITE_APPLOVIN_ANDROID_GENERAL_AUDIENCE_ONLY=true
VITE_APPLOVIN_ANDROID_SDK_KEY=Z3rGm2U66OxDUU789s3cOd_ZEQ4X5DTfS61WPmPZP1hOPeGsrkvROU3y9P_c4iMHCNtekGcC0wS9bLWsyGwBUP
VITE_APPLOVIN_ANDROID_REWARDED_ID=a530ac16c61b0899
VITE_APPLOVIN_ANDROID_INTERSTITIAL_ID=ac793825199f97bd
VITE_APPLOVIN_ALLOW_PARTIAL_UNITS=true

VITE_APPSFLYER_ENABLED=true
VITE_APPSFLYER_DEV_KEY=fZvuk792H9hJQKmaTwuXxA
VITE_APPSFLYER_APPLE_APP_ID=6793860059
VITE_APPSFLYER_DEBUG_LOGGING=false

VITE_FB_ENABLED=true
VITE_FB_APP_ID=4138472436283342
VITE_FB_CLIENT_TOKEN=df7e72e4b37b02ff036dc836d8eea518

# Our own Firebase project (2026-07-27). Remote Config is owned here — we have
# admin access, unlike the publisher's `mable-run`, which this account cannot
# open. Android analytics also lands here (native-resources/android-config/
# google-services.json); iOS still ships the publisher's plist, so iOS analytics
# goes to `mable-run` until that call is made. See docs/ad-config.md.
VITE_FIREBASE_API_KEY=AIzaSyDtO6ICYY3wzV2hG7w9cNj27hspshSRu5g
VITE_FIREBASE_PROJECT_ID=marble-run-basegamelab
VITE_FIREBASE_APP_ID=1:993722317077:android:53094b7d303d1811ff111c
VITE_PRIVACY_POLICY_URL=https://basegamelab.com/marble-run/privacy
VITE_TERMS_URL=https://basegamelab.com/marble-run/terms
