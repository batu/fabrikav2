{
  "schemaVersion": 1,
  "game": "find_the_bird",
  "capacitorAppId": "com.basegamelab.findthebird",
  "ios": {
    "bundleId": "com.basegamelab.findthebird",
    "displayName": "Find The Bird",
    "swiftToolsVersion": "6.1",
    "deploymentTarget": "15",
    "targetedDeviceFamily": "1",
    "trackingUsageDescription": null,
    "localPackages": [
      {
        "name": "CapacitorApp",
        "path": "../../../../../node_modules/@capacitor/app",
        "product": "CapacitorApp"
      },
      {
        "name": "CapacitorHaptics",
        "path": "../../../../../node_modules/@capacitor/haptics",
        "product": "CapacitorHaptics"
      },
      {
        "name": "CapacitorLocalNotifications",
        "path": "../../../../../node_modules/@capacitor/local-notifications",
        "product": "CapacitorLocalNotifications"
      },
      {
        "name": "CapacitorFirebaseCrashlytics",
        "path": "../../../../../node_modules/@capacitor-firebase/crashlytics",
        "product": "CapacitorFirebaseCrashlytics"
      },
      {
        "name": "RevenuecatPurchasesCapacitor",
        "path": "../../../../../node_modules/@revenuecat/purchases-capacitor",
        "product": "RevenuecatPurchasesCapacitor"
      },
      {
        "name": "CapacitorCommunityAdmob",
        "path": "../../../../../node_modules/@capacitor-community/admob",
        "product": "CapacitorCommunityAdmob"
      }
    ],
    "remotePackages": [
      {
        "name": "capacitor-swift-pm",
        "url": "https://github.com/ionic-team/capacitor-swift-pm.git",
        "requirement": "exact",
        "version": "8.4.1",
        "products": [
          "Capacitor",
          "Cordova"
        ]
      },
      {
        "name": "AppsFlyerFramework-Strict",
        "url": "https://github.com/AppsFlyerSDK/AppsFlyerFramework-Strict",
        "requirement": "from",
        "version": "6.17.5",
        "products": [
          "AppsFlyerLib-Strict"
        ]
      }
    ],
    "swiftSources": [
      "FindTheDogBridgeViewController.swift",
      "AppsFlyerAttributionPlugin.swift"
    ],
    "privacyManifest": "PrivacyInfo.xcprivacy",
    "adMobEnabledEnv": "VITE_ADMOB_IOS_ENABLED",
    "adMobApplicationIdEnv": "VITE_ADMOB_IOS_APP_ID",
    "adMobPublicConfig": "../../config/admob.public.json",
    "skAdNetworkCatalog": "admob-skadnetwork-ids.json",
    "skAdNetworkExpectedCount": 1,
    "crashlyticsSymbolUpload": true,
    "firebaseProjectId": "find-the-bird-basegamelab"
  }
}
